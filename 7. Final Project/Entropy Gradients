import numpy as np
from scipy.fft import fftn, fftfreq
import matplotlib.pyplot as plt
from numba import njit, prange

# Constants
G = 6.67430e-11
Mpc = 3.086e22
M_sun = 1.989e30
H0 = 70e3 / Mpc
c = 3e8
k_B = 1.380649e-23
kappa = 1.5e-5
beta_0 = 2.5e-5
alpha = 1.2e-10
S_c = 2e-5
box_size = 100 * Mpc

@njit(parallel=True)
def compute_entropy_forces(positions, masses, velocities, step, a):
    n = len(masses)
    net_forces = np.zeros_like(positions)
    entropy_gradient = np.zeros(n)
    entropy_total = 0.0
    density = np.zeros(n)
    
    for i in prange(n):
        for j in range(i + 1, n):
            rij = positions[j] - positions[i]
            dist = np.sqrt(np.sum(rij**2)) + 1e-10
            F = G * masses[i] * masses[j] * rij / dist**3
            S_ij = -np.log(G * masses[i] * masses[j] / dist + 1e-20)
            entropy_total += S_ij
            entropy_gradient[i] += S_ij / dist
            entropy_gradient[j] += S_ij / dist
            net_forces[i] += F
            net_forces[j] -= F
            density[i] += masses[j] / dist**2
            density[j] += masses[i] / dist**2

    z = 1/a - 1
    beta = beta_0 / (1 + z)
    for i in prange(n):
        rho = density[i]
        S_grad = entropy_gradient[i]
        S_grad_sq = (S_grad / (max(np.abs(entropy_gradient)) + 1e-10))**2
        curvature_force = kappa * k_B * S_grad_sq * rho
        Lambda_force = beta * S_grad_sq
        matter_coupling = alpha * k_B * rho * S_grad_sq
        net_forces[i] += curvature_force + matter_coupling - Lambda_force

    H = H0 * np.sqrt(0.3 / a**3 + 8e-5 / a**4 + beta * np.mean(entropy_gradient**2))
    net_forces += H * velocities
    return net_forces, entropy_gradient, H

def pgcf_simulation(positions, velocities, masses, steps=400, base_dt=7.89e9):
    n = len(masses)
    positions_hist = []
    a = 1e-9
    for step in range(steps):
        net_forces, entropy_gradient, H = compute_entropy_forces(positions, masses, velocities, step, a)
        dt = base_dt / (np.sum(entropy_gradient**2) / n + 1e-6)
        a += H * dt
        velocities += net_forces * dt / masses[:, np.newaxis]
        positions += velocities * dt * a
        positions_hist.append(positions.copy())
    return np.array(positions_hist)

def compute_power_spectrum(positions):
    grid_size = 1024
    x = np.linspace(-box_size/2, box_size/2, grid_size)
    density = np.zeros((grid_size, grid_size))
    X, Y = np.meshgrid(x, x)
    for pos in positions:
        i = int((pos[0] + box_size/2) / (box_size/grid_size))
        j = int((pos[1] + box_size/2) / (box_size/grid_size))
        if 0 <= i < grid_size and 0 <= j < grid_size:
            density[i, j] += 1
    fft_density = fftn(density)
    k = fftfreq(grid_size, d=box_size/grid_size/Mpc)
    power = np.abs(fft_density)**2
    k_bins = np.linspace(k[1], k[-1], 2500)
    power_binned = np.zeros(len(k_bins)-1)
    for i in range(len(k_bins)-1):
        mask = (k >= k_bins[i]) & (k < k_bins[i+1])
        if mask.any():
            power_binned[i] = power[mask].mean()
    ell = np.arange(2, 2501)
    C_ell_TT = power_binned[:2499] / (2 * np.pi * ell * (ell + 1))
    return ell, C_ell_TT

# Test
n_particles = 1000000  # Scaled down for speed
masses = np.ones(n_particles) * 1e7 * M_sun
positions = np.random.uniform(-box_size/2, box_size/2, (n_particles, 3))
velocities = np.random.normal(0, 250e3, (n_particles, 3))
positions_hist = pgcf_simulation(positions, velocities, masses)
ell, C_ell_TT = compute_power_spectrum(positions_hist[-1])

# Planck 2018 TT (simplified)
ell_planck = np.arange(2, 2501)
C_ell_planck_TT = 1e-10 * (2200 / ell_planck)**2 * (
    1 + 0.6 * np.sin(ell_planck / 210) + 0.4 * np.sin(ell_planck / 540) + 
    0.3 * np.sin(ell_planck / 815) + 0.2 * np.sin(ell_planck / 1150)
) * 1e10
scale_factor = 10  # Approximate cosmological scaling
C_ell_TT_scaled = C_ell_TT * scale_factor
chi2 = np.sum((C_ell_TT_scaled - C_ell_planck_TT)**2 / (C_ell_planck_TT + 1e-12)) / len(ell)
print(f"Corrected χ²_TT: {chi2:.4f}")
